generator client {
  provider   = "prisma-client"
  output     = "../server/generated/prisma"
  engineType = "client"
  runtime    = "nodejs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["tasklattice"]
}

enum ProjectRole {
  admin
  member

  @@map("project_role")
  @@schema("tasklattice")
}

enum IdentityType {
  local
  oidc

  @@map("identity_type")
  @@schema("tasklattice")
}

enum SystemRole {
  user
  super_administrator

  @@map("system_role")
  @@schema("tasklattice")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
  @@schema("tasklattice")
}

enum McpDiscoveryStatus {
  HEALTHY
  PERMISSION_REQUIRED
  UNCHECKED
  UNAVAILABLE

  @@map("mcp_discovery_status")
  @@schema("tasklattice")
}

model User {
  id          String     @id
  username    String     @unique
  email       String     @unique
  displayName String     @map("display_name")
  city        String?
  timezone    String     @default("UTC")
  theme       String     @default("system")
  systemRole  SystemRole @default(user) @map("system_role")
  status      UserStatus @default(active)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdProjects Project[]           @relation("ProjectCreator")
  identities      UserIdentity[]
  memberships     ProjectMember[]
  invitations     ProjectInvitation[] @relation("InvitationCreator")

  @@map("users")
  @@schema("tasklattice")
}

model UserIdentity {
  id        String       @id
  userId    String       @map("user_id")
  type      IdentityType
  issuer    String
  subject   String
  username  String?
  email     String?
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential LocalCredential?

  @@unique([issuer, subject])
  @@unique([type, username])
  @@index([userId])
  @@map("user_identities")
  @@schema("tasklattice")
}

model LocalCredential {
  identityId   String   @id @map("identity_id")
  passwordHash String   @map("password_hash")
  changedAt    DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  identity UserIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@map("local_credentials")
  @@schema("tasklattice")
}

model Project {
  id        String   @id
  name      String
  type      String
  avatar    String?
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator                         User                                        @relation("ProjectCreator", fields: [createdBy], references: [id])
  humanMembers                    ProjectMember[]
  invitations                     ProjectInvitation[]
  agents                          AgentRecord[]
  providerAccounts                ProviderAccountRecord[]
  modelDeployments                ModelDeploymentRecord[]
  inferenceGateways               InferenceGatewayRecord[]
  modelProfiles                   ModelProfileRecord[]
  modelProfileBindings            ModelProfileBindingRecord[]
  modelProfileAudit               ModelProfileAuditRecord[]
  sandboxPolicies                 SandboxPolicyRecord[]
  accessPolicies                  AccessPolicyRecord[]
  accessPolicyVersions            AccessPolicyVersionRecord[]
  skills                          SkillRecord[]
  mcpServers                      McpServerRecord[]
  knowledgeSources                KnowledgeSourceRecord[]
  specializations                 AgentSpecializationRecord[]
  costAttributions                CostAttributionMappingRecord[]
  modelEndpointMaps               ModelEndpointMappingRecord[]
  usageFacts                      ModelUsageFactRecord[]
  usageObservations               ModelUsageFactObservation[]
  usageDaily                      ModelUsageDailyRecord[]
  costSyncCheckpoints             CostSyncCheckpointRecord[]
  virtualEmployees                VirtualEmployeeRecord[]
  virtualEmployeeModelAccess      VirtualEmployeeModelAccessRecord[]
  virtualEmployeeIdentities       IdentityBindingRecord[]
  virtualEmployeeAccessScopes     AccessScopeBindingRecord[]
  virtualEmployeeInstanceBindings AgentInstanceVirtualEmployeeBindingRecord[]
  virtualEmployeeAudit            VirtualEmployeeAuditRecord[]
  quota                           ProjectQuotaRecord?

  @@map("projects")
  @@schema("tasklattice")
}

model ProjectQuotaRecord {
  projectId                    String    @id @map("project_id")
  hardBudgetUsd                Decimal?  @map("hard_budget_usd") @db.Decimal(18, 6)
  budgetDuration               String?   @map("budget_duration")
  tpmLimit                     BigInt?   @map("tpm_limit")
  maxInstances                 Int?      @map("max_instances")
  maxMcpIntegrations           Int?      @map("max_mcp_integrations")
  maxKnowledgeBaseIntegrations Int?      @map("max_knowledge_base_integrations")
  litellmTeamId                String?   @map("litellm_team_id")
  syncStatus                   String    @default("pending") @map("sync_status")
  lastSyncedAt                 DateTime? @map("last_synced_at") @db.Timestamptz(6)
  lastSyncError                String?   @map("last_sync_error")
  updatedBy                    String?   @map("updated_by")
  revision                     Int       @default(1)
  createdAt                    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_quotas")
  @@schema("tasklattice")
}

model VirtualEmployeeRecord {
  projectId    String   @map("project_id")
  id           String
  name         String
  displayName  String   @map("display_name")
  description  String?
  businessRole String?  @map("business_role")
  ownerTeamId  String?  @map("owner_team_id")
  environment  String
  status       String
  tags         Json
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project      Project                                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  modelAccess  VirtualEmployeeModelAccessRecord?
  identities   IdentityBindingRecord[]
  accessScopes AccessScopeBindingRecord[]
  instances    AgentInstanceVirtualEmployeeBindingRecord[]
  auditEvents  VirtualEmployeeAuditRecord[]

  @@id([projectId, id])
  @@unique([projectId, name])
  @@index([projectId, status])
  @@index([projectId, ownerTeamId])
  @@map("virtual_employees")
  @@schema("tasklattice")
}

model VirtualEmployeeModelAccessRecord {
  projectId           String    @map("project_id")
  id                  String
  virtualEmployeeId   String    @map("virtual_employee_id")
  provider            String
  litellmTeamId       String?   @map("litellm_team_id")
  litellmKeyId        String?   @map("litellm_key_id")
  keyAlias            String    @map("key_alias")
  keyLastFour         String?   @map("key_last_four")
  allowedModels       Json      @map("allowed_models")
  accessGroups        Json      @map("access_groups")
  maxBudget           Decimal?  @map("max_budget") @db.Decimal(18, 6)
  budgetDuration      String?   @map("budget_duration")
  rpmLimit            Int?      @map("rpm_limit")
  tpmLimit            Int?      @map("tpm_limit")
  maxParallelRequests Int?      @map("max_parallel_requests")
  keyDuration         String    @map("key_duration")
  expiresAt           DateTime? @map("expires_at") @db.Timestamptz(6)
  fallbackModels      Json      @map("fallback_models")
  secretReference     String?   @map("secret_reference")
  syncStatus          String    @map("sync_status")
  lastSyncedAt        DateTime? @map("last_synced_at") @db.Timestamptz(6)
  lastSyncError       String?   @map("last_sync_error")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  virtualEmployee VirtualEmployeeRecord @relation(fields: [projectId, virtualEmployeeId], references: [projectId, id], onDelete: Restrict)

  @@id([projectId, id])
  @@unique([projectId, virtualEmployeeId], map: "virtual_employee_model_access_employee_unique")
  @@index([projectId, virtualEmployeeId])
  @@map("virtual_employee_model_access")
  @@schema("tasklattice")
}

model IdentityBindingRecord {
  projectId         String   @map("project_id")
  id                String
  virtualEmployeeId String   @map("virtual_employee_id")
  identityType      String   @map("identity_type")
  provider          String
  externalReference String   @map("external_reference")
  displayName       String   @map("display_name")
  system            String?
  metadata          Json
  status            String
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  virtualEmployee VirtualEmployeeRecord @relation(fields: [projectId, virtualEmployeeId], references: [projectId, id], onDelete: Restrict)

  @@id([projectId, id])
  @@index([projectId, virtualEmployeeId])
  @@map("identity_bindings")
  @@schema("tasklattice")
}

model AccessScopeBindingRecord {
  projectId           String   @map("project_id")
  id                  String
  virtualEmployeeId   String   @map("virtual_employee_id")
  resourceType        String   @map("resource_type")
  resourceId          String   @map("resource_id")
  actions             Json
  conditions          Json
  enforcementProvider String   @map("enforcement_provider")
  approvalStatus      String   @map("approval_status")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  virtualEmployee VirtualEmployeeRecord @relation(fields: [projectId, virtualEmployeeId], references: [projectId, id], onDelete: Restrict)

  @@id([projectId, id])
  @@index([projectId, virtualEmployeeId])
  @@map("access_scope_bindings")
  @@schema("tasklattice")
}

model AgentInstanceVirtualEmployeeBindingRecord {
  projectId         String   @map("project_id")
  id                String
  instanceId        String   @map("instance_id")
  virtualEmployeeId String   @map("virtual_employee_id")
  boundAt           DateTime @default(now()) @map("bound_at") @db.Timestamptz(6)
  boundBy           String   @map("bound_by")

  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  virtualEmployee VirtualEmployeeRecord @relation(fields: [projectId, virtualEmployeeId], references: [projectId, id], onDelete: Restrict)

  @@id([projectId, id])
  @@unique([projectId, instanceId])
  @@index([projectId, virtualEmployeeId])
  @@map("agent_instance_virtual_employee_bindings")
  @@schema("tasklattice")
}

model VirtualEmployeeAuditRecord {
  projectId         String   @map("project_id")
  id                String
  virtualEmployeeId String   @map("virtual_employee_id")
  eventType         String   @map("event_type")
  actor             String
  result            String
  message           String
  metadata          Json
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  virtualEmployee VirtualEmployeeRecord @relation(fields: [projectId, virtualEmployeeId], references: [projectId, id], onDelete: Restrict)

  @@id([projectId, id])
  @@index([projectId, virtualEmployeeId, createdAt(sort: Desc)])
  @@map("virtual_employee_audit")
  @@schema("tasklattice")
}

model ProjectMember {
  projectId String      @map("project_id")
  userId    String      @map("user_id")
  role      ProjectRole
  joinedAt  DateTime    @default(now()) @map("joined_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
  @@schema("tasklattice")
}

model ProjectInvitation {
  id        String      @id
  projectId String      @map("project_id")
  email     String
  role      ProjectRole
  invitedBy String      @map("invited_by")
  status    String      @default("pending")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviter User    @relation("InvitationCreator", fields: [invitedBy], references: [id])

  @@unique([projectId, email])
  @@map("project_invitations")
  @@schema("tasklattice")
}

model AgentRecord {
  projectId String   @map("project_id")
  id        String
  payload   Json
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@map("agents")
  @@schema("tasklattice")
}

model ProviderAccountRecord {
  projectId         String                  @map("project_id")
  id                String
  payload           Json
  credentialPayload String                  @map("credential_payload")
  createdAt         DateTime                @map("created_at") @db.Timestamptz(6)
  project           Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  modelDeployments  ModelDeploymentRecord[]

  @@id([projectId, id])
  @@map("provider_accounts")
  @@schema("tasklattice")
}

model ModelDeploymentRecord {
  projectId         String                @map("project_id")
  id                String
  providerAccountId String                @map("provider_account_id")
  payload           Json
  createdAt         DateTime              @map("created_at") @db.Timestamptz(6)
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  providerAccount   ProviderAccountRecord @relation(fields: [projectId, providerAccountId], references: [projectId, id], onDelete: Cascade)

  @@id([projectId, id])
  @@map("model_deployments")
  @@schema("tasklattice")
}

model InferenceGatewayRecord {
  projectId String   @map("project_id")
  id        String
  payload   Json
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@map("inference_gateways")
  @@schema("tasklattice")
}

model ModelProfileRecord {
  projectId String                      @map("project_id")
  id        String
  payload   Json
  createdAt DateTime                    @map("created_at") @db.Timestamptz(6)
  project   Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bindings  ModelProfileBindingRecord[]

  @@id([projectId, id])
  @@map("model_profiles")
  @@schema("tasklattice")
}

model ModelProfileBindingRecord {
  projectId      String             @map("project_id")
  id             String
  modelProfileId String             @map("model_profile_id")
  agentId        String             @map("agent_id")
  payload        Json
  createdAt      DateTime           @map("created_at") @db.Timestamptz(6)
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  modelProfile   ModelProfileRecord @relation(fields: [projectId, modelProfileId], references: [projectId, id], onDelete: Cascade)

  @@id([projectId, id])
  @@index([projectId, agentId, createdAt(sort: Desc)], map: "model_profile_bindings_agent_idx")
  @@index([projectId, modelProfileId, createdAt(sort: Desc)], map: "model_profile_bindings_profile_idx")
  @@map("model_profile_bindings")
  @@schema("tasklattice")
}

model ModelProfileAuditRecord {
  projectId      String   @map("project_id")
  eventId        String   @map("event_id")
  modelProfileId String   @map("model_profile_id")
  payload        Json
  createdAt      DateTime @map("created_at") @db.Timestamptz(6)
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, eventId])
  @@index([projectId, modelProfileId, createdAt(sort: Desc)], map: "model_profile_audit_profile_idx")
  @@map("model_profile_audit")
  @@schema("tasklattice")
}

model SandboxPolicyRecord {
  projectId String   @map("project_id")
  id        String
  payload   Json
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@map("sandbox_policies")
  @@schema("tasklattice")
}

model AccessPolicyRecord {
  projectId String   @map("project_id")
  id        String
  payload   Json
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)

  project  Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions AccessPolicyVersionRecord[]

  @@id([projectId, id])
  @@index([projectId, updatedAt(sort: Desc)], map: "access_policies_updated_idx")
  @@map("access_policies")
  @@schema("tasklattice")
}

model AccessPolicyVersionRecord {
  projectId String   @map("project_id")
  policyId  String   @map("policy_id")
  revision  Int
  payload   Json
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  policy  AccessPolicyRecord @relation(fields: [projectId, policyId], references: [projectId, id], onDelete: Cascade)

  @@id([projectId, policyId, revision])
  @@index([projectId, policyId, createdAt(sort: Desc)], map: "access_policy_versions_created_idx")
  @@map("access_policy_versions")
  @@schema("tasklattice")
}

model SkillRecord {
  projectId String   @map("project_id")
  id        String
  payload   Json
  sortOrder Int      @default(1000) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@map("skills")
  @@schema("tasklattice")
}

model McpServerRecord {
  projectId             String             @map("project_id")
  id                    String
  litellmServerId       String             @unique @map("litellm_server_id")
  payload               Json
  discoveryStatus       McpDiscoveryStatus @default(UNCHECKED) @map("discovery_status")
  lastDiscoveryAttemptAt DateTime?          @map("last_discovery_attempt_at") @db.Timestamptz(6)
  lastDiscoveredAt      DateTime?           @map("last_discovered_at") @db.Timestamptz(6)
  lastDiscoveryError    String?             @map("last_discovery_error")
  sortOrder             Int                @default(1000) @map("sort_order")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  project               Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tools                 McpToolRecord[]

  @@id([projectId, id])
  @@map("mcp_servers")
  @@schema("tasklattice")
}

model McpToolRecord {
  projectId    String   @map("project_id")
  mcpServerId  String   @map("mcp_server_id")
  name         String
  title        String?
  description  String?
  inputSchema  Json     @map("input_schema")
  outputSchema Json?    @map("output_schema")
  annotations  Json?
  discoveredAt DateTime @map("discovered_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  server       McpServerRecord @relation(fields: [projectId, mcpServerId], references: [projectId, id], onDelete: Cascade)

  @@id([projectId, mcpServerId, name])
  @@index([projectId, mcpServerId])
  @@map("mcp_tools")
  @@schema("tasklattice")
}

model KnowledgeSourceRecord {
  projectId String   @map("project_id")
  id        String
  payload   Json
  sortOrder Int      @default(1000) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@map("knowledge_sources")
  @@schema("tasklattice")
}

model AgentSpecializationRecord {
  projectId String   @map("project_id")
  id        String
  payload   Json
  sortOrder Int      @default(1000) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@map("agent_specializations")
  @@schema("tasklattice")
}

model CostAttributionMappingRecord {
  projectId           String    @map("project_id")
  id                  String
  environmentId       String    @map("environment_id")
  instanceId          String    @map("instance_id")
  instanceName        String    @map("instance_name")
  liteLLMVirtualKeyId String?   @map("litellm_virtual_key_id")
  hashedToken         String?   @map("hashed_token")
  virtualKeyAlias     String    @map("virtual_key_alias")
  liteLLMUserId       String?   @map("litellm_user_id")
  liteLLMTeamId       String?   @map("litellm_team_id")
  providerAccountId   String?   @map("provider_account_id")
  validFrom           DateTime  @map("valid_from") @db.Timestamptz(6)
  validTo             DateTime? @map("valid_to") @db.Timestamptz(6)
  createdAt           DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @map("updated_at") @db.Timestamptz(6)
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@index([projectId, liteLLMVirtualKeyId, validFrom, validTo], map: "cost_attribution_key_time_idx")
  @@index([projectId, hashedToken, validFrom, validTo], map: "cost_attribution_hash_time_idx")
  @@index([projectId, liteLLMUserId, validFrom, validTo], map: "cost_attribution_user_time_idx")
  @@map("cost_attribution_mapping")
  @@schema("tasklattice")
}

model ModelEndpointMappingRecord {
  projectId           String    @map("project_id")
  id                  String
  modelEndpointId     String    @map("model_endpoint_id")
  modelEndpointName   String    @map("model_endpoint_name")
  liteLLMModelName    String?   @map("litellm_model_name")
  liteLLMModelGroup   String?   @map("litellm_model_group")
  liteLLMModelId      String?   @map("litellm_model_id")
  provider            String
  providerAccountId   String    @map("provider_account_id")
  providerAccountName String    @map("provider_account_name")
  validFrom           DateTime  @map("valid_from") @db.Timestamptz(6)
  validTo             DateTime? @map("valid_to") @db.Timestamptz(6)
  createdAt           DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @map("updated_at") @db.Timestamptz(6)
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@index([projectId, liteLLMModelName, validFrom, validTo], map: "model_endpoint_name_time_idx")
  @@index([projectId, liteLLMModelGroup, validFrom, validTo], map: "model_endpoint_group_time_idx")
  @@index([projectId, liteLLMModelId, validFrom, validTo], map: "model_endpoint_id_time_idx")
  @@map("model_endpoint_mapping")
  @@schema("tasklattice")
}

model ModelUsageFactRecord {
  projectId                String    @map("project_id")
  eventId                  String    @map("event_id")
  requestId                String    @map("request_id")
  requestStartTime         DateTime  @map("request_start_time") @db.Timestamptz(6)
  firstTokenTime           DateTime? @map("first_token_time") @db.Timestamptz(6)
  responseEndTime          DateTime? @map("response_end_time") @db.Timestamptz(6)
  usageDate                DateTime  @map("usage_date") @db.Date
  usageHour                Int       @map("usage_hour") @db.SmallInt
  environmentId            String    @map("environment_id")
  instanceId               String?   @map("instance_id")
  instanceName             String?   @map("instance_name")
  modelEndpointId          String?   @map("model_endpoint_id")
  modelEndpointName        String?   @map("model_endpoint_name")
  providerAccountId        String?   @map("provider_account_id")
  providerAccountName      String?   @map("provider_account_name")
  virtualKeyId             String?   @map("virtual_key_id")
  virtualKeyAlias          String?   @map("virtual_key_alias")
  liteLLMUserId            String?   @map("litellm_user_id")
  liteLLMTeamId            String?   @map("litellm_team_id")
  organizationId           String?   @map("organization_id")
  endUserId                String?   @map("end_user_id")
  requestedModel           String    @map("requested_model")
  resolvedModel            String    @map("resolved_model")
  modelGroup               String    @map("model_group")
  provider                 String
  callType                 String    @map("call_type")
  promptTokens             BigInt    @map("prompt_tokens")
  completionTokens         BigInt    @map("completion_tokens")
  totalTokens              BigInt    @map("total_tokens")
  cachedInputTokens        BigInt    @map("cached_input_tokens")
  cacheCreationInputTokens BigInt    @map("cache_creation_input_tokens")
  reasoningTokens          BigInt    @map("reasoning_tokens")
  promptCostUsd            Decimal?  @map("prompt_cost_usd")
  completionCostUsd        Decimal?  @map("completion_cost_usd")
  totalCostUsd             Decimal?  @map("total_cost_usd")
  providerReportedCostUsd  Decimal?  @map("provider_reported_cost_usd")
  liteLLMCalculatedCostUsd Decimal?  @map("litellm_calculated_cost_usd")
  costStatus               String    @map("cost_status")
  costSource               String    @map("cost_source")
  priceVersion             String    @map("price_version")
  successCount             Int       @map("success_count") @db.SmallInt
  failureCount             Int       @map("failure_count") @db.SmallInt
  latencyMs                Int?      @map("latency_ms")
  timeToFirstTokenMs       Int?      @map("time_to_first_token_ms")
  httpStatusCode           Int?      @map("http_status_code")
  errorType                String?   @map("error_type")
  retryCount               Int       @map("retry_count")
  cacheHit                 Boolean   @map("cache_hit")
  fallbackUsed             Boolean   @map("fallback_used")
  status                   String
  tags                     Json      @default("[]")
  metadata                 Json      @default("{}")
  sourceRecordHash         String    @map("source_record_hash")
  correctionOfEventId      String?   @map("correction_of_event_id")
  createdAt                DateTime  @map("created_at") @db.Timestamptz(6)
  project                  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, eventId])
  @@unique([projectId, requestId])
  @@index([projectId, requestStartTime], map: "model_usage_fact_time_idx")
  @@map("model_usage_fact")
  @@schema("tasklattice")
}

model ModelUsageFactObservation {
  id               BigInt   @id @default(autoincrement())
  projectId        String   @map("project_id")
  eventId          String   @map("event_id")
  requestId        String   @map("request_id")
  observedAt       DateTime @map("observed_at") @db.Timestamptz(6)
  reason           String
  sourceRecordHash String   @map("source_record_hash")
  payload          Json
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, eventId])
  @@map("model_usage_fact_observation")
  @@schema("tasklattice")
}

model ModelUsageDailyRecord {
  projectId          String   @map("project_id")
  usageDate          DateTime @map("usage_date") @db.Date
  timezone           String
  environmentId      String   @map("environment_id")
  groupType          String   @map("group_type")
  groupId            String   @map("group_id")
  groupName          String   @map("group_name")
  spendUsd           Decimal  @map("spend_usd")
  promptTokens       BigInt   @map("prompt_tokens")
  completionTokens   BigInt   @map("completion_tokens")
  totalTokens        BigInt   @map("total_tokens")
  requests           BigInt
  successfulRequests BigInt   @map("successful_requests")
  failedRequests     BigInt   @map("failed_requests")
  activeObjectCount  Int      @map("active_object_count")
  firstRequestAt     DateTime @map("first_request_at") @db.Timestamptz(6)
  lastRequestAt      DateTime @map("last_request_at") @db.Timestamptz(6)
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, usageDate, timezone, environmentId, groupType, groupId])
  @@map("model_usage_daily")
  @@schema("tasklattice")
}

model CostSyncCheckpointRecord {
  projectId             String    @map("project_id")
  source                String
  cursor                String?   @map("cursor_value")
  lastSuccessfulEndTime DateTime? @map("last_successful_end_time") @db.Timestamptz(6)
  lastSyncAt            DateTime? @map("last_sync_at") @db.Timestamptz(6)
  syncLagSeconds        Int?      @map("sync_lag_seconds")
  processedRecords      BigInt    @default(0) @map("processed_records")
  failedRecords         BigInt    @default(0) @map("failed_records")
  duplicateRecords      BigInt    @default(0) @map("duplicate_records")
  lateArrivingRecords   BigInt    @default(0) @map("late_arriving_records")
  sourceSpendUsd        Decimal   @default(0) @map("source_spend_usd")
  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, source])
  @@map("cost_sync_checkpoint")
  @@schema("tasklattice")
}
