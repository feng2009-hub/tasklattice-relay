FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /opt/tali/model-guardrails

COPY services/model-guardrails/pyproject.toml ./pyproject.toml
COPY services/model-guardrails/app ./app
COPY services/model-guardrails/profiles ./profiles
COPY services/model-guardrails/README.md ./README.md

RUN pip install . \
    && useradd --system --uid 65532 --no-create-home tali

USER 65532:65532
EXPOSE 8091

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8091"]
